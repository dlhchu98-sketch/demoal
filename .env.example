# Chế độ hoạt động: demo | live
APP_MODE=demo
APP_HOST=0.0.0.0
APP_PORT=8000

# Bảo mật JWT & Tài khoản khởi tạo (BẮT BUỘC thay đổi khi triển khai thật)
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_EXPIRE_MINUTES=720
DEFAULT_ADMIN_EMAIL=admin@legalai.vn
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_USER_EMAIL=user@legalai.vn
DEFAULT_USER_PASSWORD=User@123

# PostgreSQL (Docker Compose tự động điền; chạy local mặc định fallback SQLite nếu bỏ trống)
POSTGRES_DB=legal_assistant
POSTGRES_USER=legal_user
POSTGRES_PASSWORD=legal_pass
# DATABASE_URL=postgresql+psycopg2://legal_user:legal_pass@localhost:5432/legal_assistant

# Qdrant Vector Database
# QDRANT_MODE: auto | remote | local
QDRANT_MODE=auto
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=vietnam_legal_docs
# QDRANT_LOCAL_PATH=data/qdrant_storage

# LLM & Embedding (Tuyệt đối không commit API key thật lên GitHub)
LLM_PROVIDER=openai_compatible
LLM_MODEL=gemini-2.0-flash
LLM_BASE_URL=
LLM_API_KEY=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Tự động quét thư mục data/legal_documents/ khi khởi động
AUTO_SCAN_ON_STARTUP=true

# Giới hạn số lần tự điều chỉnh của Agent
MAX_SELF_CORRECTION_ATTEMPTS=2
